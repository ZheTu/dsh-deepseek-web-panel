{
  "name": "@local/dsh-deepseek-web-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness desktop plugin that embeds the DeepSeek web chat in the central panel.",
  "license": "MIT",
  "author": "ZheTu (https://github.com/ZheTu)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZheTu/dsh-deepseek-web-panel.git"
  },
  "homepage": "https://github.com/ZheTu/dsh-deepseek-web-panel#readme",
  "bugs": {
    "url": "https://github.com/ZheTu/dsh-deepseek-web-panel/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "deepseek",
    "webview",
    "chat"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
